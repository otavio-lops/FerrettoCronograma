{
  "manifest_version": 3,
  "name": "Ferretto Cronograma Personalizado",
  "version": "1.5.2",
  "description": "Personalize seu cronograma de estudos na plataforma do Ferretto.",
  "icons": {
    "16": "images/icon.png",
    "48": "images/icon.png",
    "128": "images/icon.png"
  },
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "service_worker": "src/background.js"
  },
  
  "content_scripts": [
    {
      "matches": [
        "https://app.professorferretto.com.br/*",
        "https://legado.professorferretto.com.br/*"
      ],
      "js": [
        "src/extension-api.js",
        "src/content.js"
      ]
    }
  ],

  "action": {
    "default_popup": "preview/index.html",
    "default_title": "Cronograma Personalizado",
    "default_icon": {
      "16": "images/icon.png",
      "48": "images/icon.png",
      "128": "images/icon.png"
    }
  },

  "permissions": [
    "storage",
    "tabs"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "extensao-cronograma@ferretto.com"
    }
  },

  "web_accessible_resources": [
    {
      "resources": [
        "preview/index.html",
        "src/extension-api.js",
        "src/listener.js",
        "preview/index.css",
        "preview/index.js",
        "preview/cronograma.js",
        "preview/funcoes.js"
      ],
      "matches": [
        "https://app.professorferretto.com.br/*",
        "https://legado.professorferretto.com.br/*"
      ]
    }
  ]
}
